<!-- Package detail page with booking form -->
<%- include('../partials/header') %>

<div class="container">
  <div class="row">
    <!-- Package Image/Placeholder -->
    <div class="col-md-6">
      <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 400px; border-radius: 8px;">
        <img 
          src="<%= package.imageUrl %>" 
          alt="<%= package.title %>" 
          style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;"
          onerror="this.style.display = 'none'"
        >
        <span class="text-white text-center">
          <i class="bi bi-image"></i> <%= package.title %>
        </span>
      </div>
    </div>

    <!-- Package Details -->
    <div class="col-md-6">
      <!-- Package Title -->
      <h1 class="mb-2"><%= package.title %></h1>

      <!-- Destination Badge -->
      <div class="mb-3">
        <span class="badge bg-info fs-6"><%= package.destination %></span>
      </div>

      <!-- Price -->
      <h2 class="text-primary fw-bold mb-3">$<%= package.price %> per person</h2>

      <!-- Duration -->
      <div class="mb-2">
        <h6 class="text-muted">📅 Duration</h6>
        <p><%= package.duration %></p>
      </div>

      <!-- Available Seats -->
      <div class="mb-3">
        <h6 class="text-muted">💺 Available Seats</h6>
        <p><strong><%= package.seats %> seats</strong> remaining</p>
      </div>

      <!-- Description -->
      <div class="mb-4">
        <h5>Description</h5>
        <p><%= package.description %></p>
      </div>

      <!-- Booking Form (only show if user is logged in) -->
      <% if (session.userId) { %>
        <div class="card border-primary mb-3">
          <div class="card-body">
            <h5 class="card-title">Book This Package</h5>

            <form method="POST" action="/bookings/book">
              <!-- Hidden Package ID -->
              <input type="hidden" name="packageId" value="<%= package._id %>">

              <!-- Number of Travelers -->
              <div class="mb-3">
                <label for="travelers" class="form-label">Number of Travelers</label>
                <input 
                  type="number" 
                  class="form-control form-control-lg" 
                  id="travelers" 
                  name="travelers" 
                  min="1" 
                  max="<%= package.seats %>"
                  value="1"
                  required
                >
                <small class="text-muted">Maximum <%= package.seats %> travelers</small>
              </div>

              <!-- Total Price Display -->
              <div class="mb-3 p-3 bg-light rounded">
                <p class="mb-1">Total Price:</p>
                <h4 class="text-primary">
                  $<span id="totalPrice"><%= package.price %></span>
                </h4>
              </div>

              <!-- Book Button -->
              <button type="submit" class="btn btn-primary btn-lg w-100">
                Book Now
              </button>
            </form>
          </div>
        </div>
      <% } else { %>
        <!-- Not logged in message -->
        <div class="alert alert-warning">
          <p class="mb-0">🔒 Please <a href="/login">login</a> or <a href="/register">register</a> to book this package.</p>
        </div>
      <% } %>

      <!-- Back Link -->
      <a href="/packages" class="btn btn-outline-secondary">← Back to Packages</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script data-price="<%= package.price %>">
  // Calculate total price when number of travelers changes
  document.getElementById('travelers').addEventListener('change', function() {
    const pricePerPerson = parseFloat(document.currentScript.getAttribute('data-price')) || 0;
    const travelers = parseFloat(this.value) || 1;
    const totalPrice = pricePerPerson * travelers;
    document.getElementById('totalPrice').textContent = totalPrice.toFixed(2);
  });
</script>
