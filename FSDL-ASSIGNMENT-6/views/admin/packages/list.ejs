<!-- Admin packages list page -->
<%- include('../../partials/header') %>

<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Manage Packages</h1>
    <!-- Add New Package Button -->
    <a href="/admin/packages/add" class="btn btn-primary">+ Add New Package</a>
  </div>

  <% if (packages.length > 0) { %>
    <!-- Packages Table -->
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th>Title</th>
            <th>Destination</th>
            <th>Price</th>
            <th>Duration</th>
            <th>Seats</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% packages.forEach(pkg => { %>
            <tr>
              <!-- Package Title -->
              <td><strong><%= pkg.title %></strong></td>

              <!-- Destination -->
              <td><%= pkg.destination %></td>

              <!-- Price -->
              <td>$<%= pkg.price %></td>

              <!-- Duration -->
              <td><%= pkg.duration %></td>

              <!-- Available Seats -->
              <td>
                <span class="badge bg-info"><%= pkg.seats %></span>
              </td>

              <!-- Actions: Edit and Delete -->
              <td>
                <!-- Edit Button -->
                <a href="/admin/packages/edit/<%= pkg._id %>" class="btn btn-sm btn-warning">
                  ✏️ Edit
                </a>

                <!-- Delete Button with Confirmation -->
                <form action="/admin/packages/delete/<%= pkg._id %>" method="POST" style="display: inline;">
                  <button 
                    type="submit" 
                    class="btn btn-sm btn-danger"
                    onclick="return confirm('Are you sure you want to delete this package?')"
                  >
                    🗑️ Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <!-- No packages message -->
    <div class="alert alert-info">
      <p class="mb-0">No packages found. <a href="/admin/packages/add">Create one now</a>!</p>
    </div>
  <% } %>

  <!-- Back Link -->
  <div class="mt-4">
    <a href="/admin" class="btn btn-outline-secondary">← Back to Dashboard</a>
  </div>
</div>

<%- include('../../partials/footer') %>
