<%- include('../partials/header') %>

<div class="container-fluid">
    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filters</h5>
                </div>
                <div class="card-body">
                    <form action="/products" method="GET" id="filterForm">
                        <!-- Search -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Search</label>
                            <input type="text" class="form-control" name="search" 
                                   value="<%= query.search || '' %>" placeholder="Search by title or brand">
                        </div>
                        
                        <!-- Category -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category</label>
                            <% const categories = ['Car', 'Bike', 'Scooter', 'Bicycle', 'Truck', 'Other']; %>
                            <% categories.forEach(cat => { %>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="category" value="<%= cat %>" 
                                       id="cat-<%= cat %>" <%= query.category && (Array.isArray(query.category) ? query.category.includes(cat) : query.category === cat) ? 'checked' : '' %>>
                                <label class="form-check-label" for="cat-<%= cat %>"><%= cat %></label>
                            </div>
                            <% }); %>
                        </div>
                        
                        <!-- Condition -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Condition</label>
                            <% const conditions = ['Like New', 'Good', 'Fair', 'Poor']; %>
                            <% conditions.forEach(cond => { %>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="condition" value="<%= cond %>" 
                                       id="cond-<%= cond.replace(' ', '') %>" <%= query.condition && (Array.isArray(query.condition) ? query.condition.includes(cond) : query.condition === cond) ? 'checked' : '' %>>
                                <label class="form-check-label" for="cond-<%= cond.replace(' ', '') %>"><%= cond %></label>
                            </div>
                            <% }); %>
                        </div>
                        
                        <!-- Fuel Type -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Fuel Type</label>
                            <% const fuelTypes = ['Petrol', 'Diesel', 'Electric', 'CNG', 'Other']; %>
                            <% fuelTypes.forEach(fuel => { %>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="fuelType" value="<%= fuel %>" 
                                       id="fuel-<%= fuel %>" <%= query.fuelType && (Array.isArray(query.fuelType) ? query.fuelType.includes(fuel) : query.fuelType === fuel) ? 'checked' : '' %>>
                                <label class="form-check-label" for="fuel-<%= fuel %>"><%= fuel %></label>
                            </div>
                            <% }); %>
                        </div>
                        
                        <!-- Price Range -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Price Range (₹)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" class="form-control" name="minPrice" 
                                           value="<%= query.minPrice || '' %>" placeholder="Min" min="0">
                                </div>
                                <div class="col-6">
                                    <input type="number" class="form-control" name="maxPrice" 
                                           value="<%= query.maxPrice || '' %>" placeholder="Max" min="0">
                                </div>
                            </div>
                        </div>
                        
                        <!-- City -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">City</label>
                            <input type="text" class="form-control" name="city" 
                                   value="<%= query.city || '' %>" placeholder="Enter city">
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search me-2"></i>Apply Filters
                            </button>
                            <a href="/products" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>Reset
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <!-- Products Grid -->
        <div class="col-lg-9 col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="mb-0">Browse Listings</h4>
                    <p class="text-muted mb-0"><%= totalProducts %> listings found</p>
                </div>
                <div class="d-flex align-items-center">
                    <label class="me-2 text-nowrap">Sort by:</label>
                    <select class="form-select form-select-sm" id="sortSelect" style="width: auto;">
                        <option value="newest" <%= !query.sort || query.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                        <option value="oldest" <%= query.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                        <option value="price_low" <%= query.sort === 'price_low' ? 'selected' : '' %>>Price: Low to High</option>
                        <option value="price_high" <%= query.sort === 'price_high' ? 'selected' : '' %>>Price: High to Low</option>
                        <option value="views" <%= query.sort === 'views' ? 'selected' : '' %>>Most Viewed</option>
                    </select>
                </div>
            </div>
            
            <% if (products.length === 0) { %>
            <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <h4 class="mt-3">No listings found</h4>
                <p class="text-muted">No listings match your search criteria. Try adjusting your filters.</p>
                <a href="/products" class="btn btn-primary">View All Listings</a>
            </div>
            <% } else { %>
            <div class="row g-4">
                <% products.forEach(product => { %>
                <div class="col-lg-4 col-md-6">
                    <div class="card product-card h-100 shadow-sm">
                        <div class="position-relative">
                            <img src="<%= product.images.length > 0 ? product.images[0] : '/images/no-image.png' %>" 
                                 class="card-img-top product-img" alt="<%= product.title %>">
                            <span class="badge condition-badge 
                                <%= product.condition === 'Like New' ? 'bg-success' : 
                                   product.condition === 'Good' ? 'bg-primary' : 
                                   product.condition === 'Fair' ? 'bg-warning' : 'bg-danger' %>">
                                <%= product.condition %>
                            </span>
                            <% if (product.status === 'sold') { %>
                            <div class="sold-overlay">
                                <span class="badge bg-dark fs-5">SOLD</span>
                            </div>
                            <% } %>
                        </div>
                        <div class="card-body">
                            <h6 class="card-title text-truncate"><%= product.title %></h6>
                            <p class="card-text text-primary fw-bold fs-5 mb-2">₹<%= product.price.toLocaleString('en-IN') %></p>
                            <div class="small text-muted mb-2">
                                <span class="me-2"><i class="bi bi-speedometer2"></i> <%= product.kmDriven.toLocaleString('en-IN') %> km</span>
                                <span><i class="bi bi-fuel-pump"></i> <%= product.fuelType %></span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center text-muted small">
                                <span><i class="bi bi-geo-alt"></i> <%= product.location.city || 'N/A' %></span>
                                <span><i class="bi bi-eye"></i> <%= product.views %> views</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <a href="/products/<%= product._id %>" class="btn btn-outline-primary w-100">View Details</a>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
            
            <!-- Pagination -->
            <% if (totalPages > 1) { %>
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="?page=<%= currentPage - 1 %><%= query.search ? '&search=' + query.search : '' %><%= query.sort ? '&sort=' + query.sort : '' %>">Previous</a>
                    </li>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %><%= query.search ? '&search=' + query.search : '' %><%= query.sort ? '&sort=' + query.sort : '' %>"><%= i %></a>
                    </li>
                    <% } %>
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="?page=<%= currentPage + 1 %><%= query.search ? '&search=' + query.search : '' %><%= query.sort ? '&sort=' + query.sort : '' %>">Next</a>
                    </li>
                </ul>
            </nav>
            <% } %>
            <% } %>
        </div>
    </div>
</div>

<script>
document.getElementById('sortSelect').addEventListener('change', function() {
    const url = new URL(window.location.href);
    url.searchParams.set('sort', this.value);
    window.location.href = url.toString();
});
</script>

<%- include('../partials/footer') %>