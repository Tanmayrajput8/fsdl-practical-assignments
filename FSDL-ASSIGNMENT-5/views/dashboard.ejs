<%- include('./partials/header') %>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Welcome, <%= user.name %>!</h2>
            <p class="text-muted mb-0">Manage your listings and account</p>
        </div>
        <% if (user.role === 'seller' || user.role === 'admin') { %>
        <a href="/products/create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>New Listing
        </a>
        <% } %>
    </div>
    
    <!-- Stats Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-3 col-6">
            <div class="card bg-primary text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 opacity-75">Total Listings</p>
                            <h2 class="mb-0 fw-bold"><%= stats.total %></h2>
                        </div>
                        <i class="bi bi-grid-3x3-gap fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-6">
            <div class="card bg-success text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 opacity-75">Active</p>
                            <h2 class="mb-0 fw-bold"><%= stats.active %></h2>
                        </div>
                        <i class="bi bi-check-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-6">
            <div class="card bg-warning text-dark shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 opacity-75">Sold</p>
                            <h2 class="mb-0 fw-bold"><%= stats.sold %></h2>
                        </div>
                        <i class="bi bi-bag-check fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-6">
            <div class="card bg-info text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1 opacity-75">Total Views</p>
                            <h2 class="mb-0 fw-bold"><%= stats.totalViews %></h2>
                        </div>
                        <i class="bi bi-eye fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Listings Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>My Listings</h5>
        </div>
        <div class="card-body">
            <% if (products.length === 0) { %>
            <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <h4 class="mt-3">No listings yet</h4>
                <p class="text-muted">You haven't posted any listings yet. Start selling!</p>
                <% if (user.role === 'seller' || user.role === 'admin') { %>
                <a href="/products/create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Post Your First Listing
                </a>
                <% } else { %>
                <p class="text-muted small">Upgrade to a seller account to start posting listings.</p>
                <% } %>
            </div>
            <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Views</th>
                            <th>Posted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(product => { %>
                        <tr>
                            <td>
                                <img src="<%= product.images && product.images.length > 0 ? product.images[0] : '/images/no-image.png' %>" 
                                     alt="<%= product.title %>" class="rounded" 
                                     style="width: 60px; height: 45px; object-fit: cover;">
                            </td>
                            <td>
                                <a href="/products/<%= product._id %>" class="text-decoration-none fw-medium">
                                    <%= product.title.length > 30 ? product.title.substring(0, 30) + '...' : product.title %>
                                </a>
                            </td>
                            <td class="fw-bold text-primary">₹<%= product.price.toLocaleString('en-IN') %></td>
                            <td>
                                <span class="badge 
                                    <%= product.status === 'available' ? 'bg-success' : 
                                       product.status === 'sold' ? 'bg-secondary' : 'bg-warning' %>">
                                    <%= product.status.charAt(0).toUpperCase() + product.status.slice(1) %>
                                </span>
                            </td>
                            <td><i class="bi bi-eye text-muted me-1"></i><%= product.views %></td>
                            <td class="small text-muted">
                                <%= new Date(product.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="/products/<%= product._id %>" class="btn btn-outline-primary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/products/<%= product._id %>/edit" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <% if (product.status === 'available') { %>
                                    <form action="/products/<%= product._id %>/mark-sold" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-outline-success" title="Mark as Sold">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                    <% } %>
                                    <form action="/products/<%= product._id %>?_method=DELETE" method="POST" class="d-inline" 
                                          onsubmit="return confirm('Are you sure you want to delete this listing?')">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>