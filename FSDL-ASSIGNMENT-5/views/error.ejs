<%- include('./partials/header') %>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center py-5">
            <div class="mb-4">
                <% if (statusCode === 404) { %>
                <i class="bi bi-search display-1 text-muted"></i>
                <% } else if (statusCode === 403) { %>
                <i class="bi bi-shield-exclamation display-1 text-warning"></i>
                <% } else if (statusCode === 401) { %>
                <i class="bi bi-lock display-1 text-danger"></i>
                <% } else { %>
                <i class="bi bi-exclamation-triangle display-1 text-danger"></i>
                <% } %>
            </div>
            
            <h1 class="display-4 fw-bold mb-3">
                <% if (statusCode === 404) { %>
                Page Not Found
                <% } else if (statusCode === 403) { %>
                Access Denied
                <% } else if (statusCode === 401) { %>
                Unauthorized
                <% } else { %>
                Oops! Something went wrong
                <% } %>
            </h1>
            
            <p class="lead text-muted mb-4"><%= message %></p>
            
            <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger text-start">
                <h6 class="alert-heading"><i class="bi bi-exclamation-circle me-2"></i>Errors:</h6>
                <ul class="mb-0">
                    <% errors.forEach(err => { %>
                    <li><%= err %></li>
                    <% }); %>
                </ul>
            </div>
            <% } %>
            
            <div class="d-flex justify-content-center gap-3">
                <a href="/" class="btn btn-primary btn-lg">
                    <i class="bi bi-house me-2"></i>Go Home
                </a>
                <button onclick="history.back()" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left me-2"></i>Go Back
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>